---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from '../utils/site-path.js';

const title = "Meteorological Musings";
const description = "Storm chase logs, research notes, and weather stories by Kyle J. Gillett.";

const posts = [
  {
    title: "Chase Log: June 19th, 2025 | Dickinson North Dakota Wedge",
    date: "19 June 2025",
    category: "Chase log · North Dakota",
    excerpt:
      "A lone supercell produced a large, dusty wedge tornado southwest of Dickinson, North Dakota, on the day before the historic Enderlin tornado and derecho.",
    href: sitePath("/chase-log-june-19th-2025-dickinson-north-dakota-wedge/"),
  },
];
---

<BaseLayout title={title} description={description}>
  <article class="container">
    <header class="page-head">
      <h1>{title}</h1>
      <p class="posts-intro">Chase logs, research topics, and other ramblings.</p>
    </header>

    <section class="posts-list" aria-label="Posts">
      {posts.map((post) => (
        <a class="card post-card post-card-hero" href={post.href}>
          <div class="card-body">
            <p class="post-meta"><span>{post.category}</span><time datetime="2025-06-19">{post.date}</time></p>
            <h2>{post.title}</h2>
            <p>{post.excerpt}</p>
            <span class="card-link">Read the post <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </section>
  </article>
</BaseLayout>
