---
import BaseLayout from "../layouts/BaseLayout.astro";
import pageContent from "../content/pages/search-for-spirit-chasing-storms-in-the-sacred-corridor.html?raw";
import { withSiteBase } from '../utils/site-path.js';
const title = 'The Search for Spirit: Chasing Storms in the Sacred Corridor';
const description = `${title} — Kyle J. Gillett`;
const date = '2026-10-06';
---
<BaseLayout title={title} description={description}>
  <article class="container">
    <header class="page-head"><h1>{title}</h1>{date && <p class="meta">{date}</p>}</header>
    <div class="page-content" set:html={withSiteBase(pageContent || "<p>Content coming soon.</p>")} />
  </article>
</BaseLayout>
