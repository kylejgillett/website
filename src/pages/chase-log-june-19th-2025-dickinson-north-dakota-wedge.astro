---
import BaseLayout from "../layouts/BaseLayout.astro";
import pageContent from "../content/pages/chase-log-june-19th-2025-dickinson-north-dakota-wedge.html?raw";
import { withSiteBase } from '../utils/site-path.js';
const title = "Chase Log: June 19th, 2025 | Dickinson North Dakota Wedge";
const description = "Chase Log: June 19th, 2025 | Dickinson North Dakota Wedge — Kyle J. Gillett";
const date = "2026-02-12";
---
<BaseLayout title={title} description={description}>
  <article class="container">
    <header class="page-head"><h1>{title}</h1>{date && <p class="meta">{date}</p>}</header>
    <div class="page-content" set:html={withSiteBase(pageContent || "<p>Content coming soon.</p>")} />
  </article>
</BaseLayout>
