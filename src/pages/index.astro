---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../utils/site-path.js';

const tiles = [
  { title: 'My Photography', href: sitePath('/photography/'), image: sitePath('/images_home/photography.webp') },
  { title: 'Research, Tools, CV, & About', href: sitePath('/about_and_work/'), image: sitePath('/images_home/research.webp') },
  { title: 'SounderPy Web App', href: 'https://sounderpy.app/', image: sitePath('/images_home/sounderpy.webp') },
  { title: 'Meteorological Musings', href: sitePath('/posts/'), image: sitePath('/images_home/musings.webp') },
];

const recent = [
  { title: 'Chase Log: June 19th, 2025', kind: 'Post', href: sitePath('/chase-log-june-19th-2025-dickinson-north-dakota-wedge/') },
  { title: 'Wildlife Field Notes', kind: 'Gallery', href: sitePath('/wildlife-field-notes/') },
  { title: 'Rear Flank Storm Interactions', kind: 'Research', href: `${sitePath('/about_and_work/')}#research-projects` },
];
---

<BaseLayout title="Home" description="Photography, atmospheric science, software tools, and field notes by Kyle J. Gillett.">
  <section class="home-hero container" aria-label="Featured photograph">
    <figure class="home-hero-visual">
      <a class="home-hero-link" href={sitePath('/photography/')} aria-label="Visit photo gallery">
        <img class="home-hero-image" src={sitePath('/images_home/hero.webp')} alt="A broad supercell storm structure over green plains at sunset." />
        <span class="home-hero-cta">Visit photo gallery <span aria-hidden="true">→</span></span>
      </a>
    </figure>
  </section>

  <nav class="home-tiles container" aria-label="Explore">
    {tiles.map((tile) => (
      <a class="home-tile" href={tile.href}>
        <img src={tile.image} alt="" loading="lazy" />
        <span>{tile.title}</span>
      </a>
    ))}
  </nav>

  <section class="home-recent container" aria-labelledby="recent-title">
    <h2 id="recent-title">Recently</h2>
    <ul>
      {recent.map((item) => (
        <li>
          <a href={item.href}>
            <strong>{item.title}</strong>
            <span>{item.kind}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="home-contact container" aria-label="Contact">
    <p>Contact: <a href="mailto:kyle.gillett@und.edu">kyle.gillett@und.edu</a></p>
  </section>
</BaseLayout>
