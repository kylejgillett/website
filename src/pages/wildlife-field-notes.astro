---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../utils/site-path.js";
import wildlifeMetadata from "../data/wildlife-metadata.json";

const title = "Wildlife Field Notes";
const description = "A field-notes gallery of wildlife photographs by Kyle J. Gillett, with species, dates, and observation details.";

const dateFormatter = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });

// Panel order is controlled here. Species not listed below appear alphabetically
// after the listed species in their group. Keep the arrays grouped by the same
// visual categories used on the page so new species are easy to place.
const speciesOrder = [
  // Birds: goose, ducks and swan, gulls, waders, game birds, raptors, other birds.
  "Canada Goose", "Trumpeter Swan",
  "Mallard", "Wood Duck", "American Coot",
  "Ring-billed Gull",
  "Great Blue Heron", "Great Egret", "Sandhill Crane",
  "Wild Turkey", "Gray Partridge",
  "Bald Eagle", "Red-tailed Hawk", "American Kestrel", "Turkey Vulture", "Snowy Owl", "Burrowing Owl", "Belted Kingfisher",
  "Common Yellowthroat", "Eastern Bluebird", "Fox Sparrow", "House Sparrow", "Tufted Titmouse", "House Wren", "Blue Jay", "Northern Cardinal", "American Robin", "Baltimore Oriole", "Cedar Waxwing", "Gray Catbird", "Red-winged Blackbird", "Cowbird",
  "Rose-breasted Grosbeak", "Tree Swallow", "White-breasted Nuthatch", "Ruby-throated Hummingbird",
  // Mammals: deer and relatives, large mammals, squirrels and other mammals.
  "White-tailed Deer", "Mule Deer", "Elk", "Moose",
  "American Bison", "Pronghorn", "Rocky Mountain Bighorn Sheep",
  "Eastern Gray Squirrel", "Black Squirrel", "Fox Squirrel", "Golden-mantled Ground Squirrel", "Black-tailed Prairie Dog", "Muskrat",
  // Reptiles and any other groups can be added below; unlisted species sort alphabetically last.
  "Painted Turtle",
];
const speciesOrderIndex = new Map(speciesOrder.map((name, index) => [name, index]));

const observations = wildlifeMetadata
  .map((species) => {
    const photos = species.photos
      .map((photo) => {
        const dateValue = photo.date ? new Date(`${photo.date}T12:00:00Z`) : null;
        return {
          ...photo,
          thumbnailSrc: sitePath(`/images_wildlife/optimized/${photo.filename.replace(/\.[^.]+$/, ".webp")}`),
          alt: `${species.commonName} photographed by Kyle J. Gillett`,
          dateLabel: dateValue && !Number.isNaN(dateValue.getTime()) ? dateFormatter.format(dateValue) : "Date not listed",
        };
      });
    return {
      group: species.group,
      name: species.commonName,
      scientific: species.scientificName,
      photos,
    };
  })
  .sort((a, b) => {
    const aOrder = speciesOrderIndex.get(a.name) ?? Number.MAX_SAFE_INTEGER;
    const bOrder = speciesOrderIndex.get(b.name) ?? Number.MAX_SAFE_INTEGER;
    return aOrder - bOrder || a.name.localeCompare(b.name);
  });
const sections = ["Birds", "Mammals", "Reptiles", "Other"].filter((section) => observations.some((item) => item.group === section));
---

<BaseLayout title={title} description={description}>
  <article class="container field-notes-page">
    <header class="field-notes-header">
      <p class="field-notes-kicker">Wildlife Photography · Species Records</p>
      <h1>{title}</h1>
      <p class="field-notes-intro">A photographic record of observed wildlife, organized by species and accompanied by identification and observation details.</p>
      <nav class="field-notes-index" aria-label="Field note categories">
        {sections.map((section) => <a href={`#${section.toLowerCase()}`}>{section}<span>{observations.filter((item) => item.group === section).length}</span></a>)}
      </nav>
      <div class="field-notes-search">
        <label for="species-search">Find a species</label>
        <input id="species-search" type="search" placeholder="Search common or scientific name" autocomplete="off" data-species-search />
        <p class="field-notes-search-status" data-search-status aria-live="polite">{observations.length} species</p>
      </div>
    </header>

    {sections.map((section) => (
      <section class="field-notes-section" id={section.toLowerCase()} aria-labelledby={`${section.toLowerCase()}-heading`} data-species-section>
        <div class="field-notes-section-heading">
          <p class="field-notes-kicker">Field notes / {String(sections.indexOf(section) + 1).padStart(2, "0")}</p>
          <h2 id={`${section.toLowerCase()}-heading`}>{section}</h2>
        </div>
        <div class="field-notes-grid">
          {observations.filter((item) => item.group === section).map((item, index) => {
            const photos = item.photos;
            const slideData = photos.map((photo) => ({ src: photo.thumbnailSrc, alt: photo.alt }));
            return (
              <article class="field-note-card" data-species-card data-search-terms={`${item.name} ${item.scientific}`}>
                <figure class="field-note-image" data-field-slideshow data-slides={JSON.stringify(slideData)} data-slide-dates={JSON.stringify(photos.map((photo) => photo.dateLabel))} data-slide-locations={JSON.stringify(photos.map((photo) => photo.location))}>
                  <img src={slideData[0].src} alt={slideData[0].alt} loading="lazy" decoding="async" data-slide-image />
                  {photos.length > 1 && <>
                    <span class="field-note-photo-count" aria-label={`${photos.length} photos in this field note`}>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="4" width="13" height="15" rx="2"/><path d="M4 8v11a2 2 0 0 0 2 2h10"/></svg>
                      <span data-slide-count aria-live="polite">1 / {photos.length}</span>
                    </span>
                    <button class="field-note-slide-button field-note-slide-previous" type="button" data-slide-previous aria-label="Show previous photo">‹</button>
                    <button class="field-note-slide-button field-note-slide-next" type="button" data-slide-next aria-label="Show next photo">›</button>
                  </>}
                </figure>
                <div class="field-note-copy">
                  <div class="field-note-title">
                    <h3>{item.name}</h3>
                    <p class="field-note-scientific">{item.scientific}</p>
                  </div>
                  <dl class="field-note-details">
                    <div><dt>Observed</dt><dd><time data-slide-date>{photos[0].dateLabel}</time></dd></div>
                    <div><dt>Location</dt><dd data-slide-location>{photos[0].location || "Not listed"}</dd></div>
                  </dl>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))}

    <footer class="field-notes-footer">
      <a class="field-notes-return" href={sitePath("/photography/")}><span aria-hidden="true">←</span> Back to Photo Gallery</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .field-notes-page { padding-bottom: 4rem; }
  .field-notes-header { max-width: 760px; margin: 0 auto; padding: clamp(3.5rem, 8vw, 6.5rem) 1rem 3rem; text-align: center; }
  .field-notes-kicker { margin: 0 0 .8rem; color: var(--ochre); font-size: .75rem; font-weight: 750; letter-spacing: .16em; text-transform: uppercase; }
  .field-notes-header h1 { margin: 0; font-family: var(--serif); font-size: clamp(2.7rem, 7vw, 5rem); font-weight: 500; letter-spacing: -.045em; line-height: 1; }
  .field-notes-intro { max-width: 600px; margin: 1.25rem auto 0; color: var(--ink-soft); font-family: var(--serif); font-size: 1.2rem; line-height: 1.65; }
  .field-notes-index { display: flex; flex-wrap: wrap; justify-content: center; gap: .65rem; margin-top: 2rem; }
  .field-notes-index a { display: flex; min-height: 2.6rem; align-items: center; gap: .7rem; padding: .5rem 1rem; border: 1px solid var(--line); border-radius: 99px; color: var(--ink); font-weight: 700; text-decoration: none; }
  .field-notes-index a:hover { border-color: var(--ochre); }
  .field-notes-index span { color: var(--ochre); font-size: .78rem; }
  .field-notes-search { max-width: 440px; margin: 2rem auto 0; text-align: left; }
  .field-notes-search label { display: block; margin-bottom: .45rem; color: var(--ink-soft); font-size: .75rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  .field-notes-search input { width: 100%; min-height: 3rem; padding: .65rem .9rem; border: 1px solid var(--line-strong); border-radius: 6px; background: var(--paper-light); color: var(--ink); font-size: 1rem; }
  .field-notes-search input::placeholder { color: var(--ink-soft); opacity: .75; }
  .field-notes-search input:focus-visible { outline: 3px solid var(--ochre); outline-offset: 3px; }
  .field-notes-search-status { min-height: 1.2em; margin: .45rem 0 0; color: var(--ink-soft); font-size: .8rem; }
  .field-notes-section { margin: 0 auto 4.5rem; }
  .field-notes-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin: 0 0 1.25rem; padding-bottom: .8rem; border-bottom: 1px solid var(--line-strong); }
  .field-notes-section-heading .field-notes-kicker { margin-bottom: .35rem; }
  .field-notes-section-heading h2 { margin: 0; font-family: var(--serif); font-size: clamp(2rem, 4vw, 3rem); font-weight: 500; }
  .field-notes-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; align-items: start; }
  .field-note-card { overflow: hidden; border: 1px solid var(--line); background: var(--paper-light); }
  .field-note-image { position: relative; margin: 0; overflow: hidden; background: rgb(0 0 0 / 8%); }
  .field-note-image img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  @media (hover: hover) and (pointer: fine) {
    .field-note-image img { transition: transform .3s ease; }
    .field-note-card:hover .field-note-image img { transform: scale(1.025); }
  }
  .field-note-image figcaption { position: absolute; right: .75rem; bottom: .75rem; padding: .35rem .55rem; background: rgb(18 22 18 / 78%); color: white; font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .field-note-photo-count { position: absolute; top: .75rem; left: .75rem; display: inline-flex; align-items: center; gap: .35rem; padding: .4rem .55rem; border: 1px solid rgb(255 255 255 / 25%); border-radius: 99px; background: rgb(18 22 18 / 78%); color: white; font-size: .75rem; font-weight: 700; }
  .field-note-photo-count svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
  .field-note-slide-button { position: absolute; top: 50%; display: grid; width: 2.5rem; height: 2.5rem; place-items: center; transform: translateY(-50%); border: 1px solid rgb(255 255 255 / 35%); border-radius: 50%; background: rgb(18 22 18 / 78%); color: white; cursor: pointer; font-size: 1.8rem; line-height: 1; transition: background-color .18s ease, border-color .18s ease; }
  .field-note-slide-button:hover { border-color: var(--ochre); background: rgb(18 22 18 / 95%); }
  .field-note-slide-button:focus-visible { outline: 3px solid var(--ochre); outline-offset: 3px; }
  .field-note-slide-previous { left: .7rem; }
  .field-note-slide-next { right: .7rem; }
  .field-note-copy { padding: 1.2rem 1.25rem 1.35rem; }
  .field-note-title { min-height: 6.8rem; }
  .field-note-copy h3 { margin: 0; font-family: var(--serif); font-size: 1.55rem; font-weight: 600; line-height: 1.15; }
  .field-note-scientific { margin: .2rem 0 0; color: var(--ink-soft); font-family: var(--serif); font-size: 1rem; font-style: italic; line-height: 1.5; }
  .field-note-description { min-height: 3.2em; margin: .9rem 0 1rem; color: var(--ink-soft); line-height: 1.55; }
  .field-note-details { display: grid; grid-template-columns: 1fr 1fr; gap: .85rem; margin: 1.1rem 0 0; padding-top: 1rem; border-top: 1px solid var(--line); }
  .field-note-details div { min-width: 0; }
  .field-note-details dt { margin-bottom: .35rem; color: var(--ink-soft); font-size: .67rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  .field-note-details dd { margin: 0; font-size: .88rem; font-weight: 650; }
  .field-notes-footer { display: flex; justify-content: center; padding: 1.5rem 0; border-top: 1px solid var(--line-strong); }
  .field-notes-return { display: inline-flex; min-height: var(--control-height); align-items: center; gap: .7rem; padding: .5rem 1.1rem; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--control-bg); color: var(--control-text); font-weight: 700; text-decoration: none; transition: border-color .18s ease, background-color .18s ease, transform .18s ease; }
  .field-notes-return:hover { transform: translateY(-2px); border-color: var(--ochre); background: var(--control-bg-hover); }
  .field-notes-return:focus-visible { outline: 3px solid var(--ochre); outline-offset: 4px; }
  @media (max-width: 850px) { .field-notes-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .field-notes-page { width: calc(100% - 1.1rem); }
    .field-notes-header { padding: 3rem .2rem 2.5rem; }
    .field-notes-intro { font-size: 1.08rem; }
    .field-notes-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
    .field-notes-section { margin-bottom: 3rem; }
    .field-note-copy { padding: .7rem .65rem .75rem; }
    .field-note-title { min-height: 8rem; }
    .field-note-copy h3 { font-size: 1.15rem; overflow-wrap: anywhere; }
    .field-note-scientific { font-size: .82rem; overflow-wrap: anywhere; }
    .field-note-details { grid-template-columns: 1fr; gap: .55rem; margin-top: .75rem; padding-top: .7rem; }
    .field-note-details dt { margin-bottom: .15rem; font-size: .59rem; }
    .field-note-details dd { font-size: .75rem; line-height: 1.35; overflow-wrap: anywhere; }
    .field-note-image img { aspect-ratio: 1; }
    .field-note-photo-count { top: .4rem; left: .4rem; gap: .2rem; padding: .3rem .4rem; font-size: .65rem; }
    .field-note-photo-count svg { width: .85rem; height: .85rem; }
    .field-note-slide-button { width: 2rem; height: 2rem; font-size: 1.45rem; }
    .field-note-slide-previous { left: .35rem; }
    .field-note-slide-next { right: .35rem; }
  }
  @media (max-width: 380px) {
    .field-notes-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
    .field-note-copy { padding: .85rem .9rem 1rem; }
    .field-note-title { min-height: 8rem; }
    .field-note-copy h3 { font-size: 1.35rem; }
    .field-note-scientific { font-size: .92rem; }
    .field-note-details { grid-template-columns: 1fr 1fr; gap: .55rem; margin-top: .9rem; padding-top: .8rem; }
    .field-note-details dt { font-size: .62rem; }
    .field-note-details dd { font-size: .8rem; }
    .field-note-image img { aspect-ratio: 4 / 4.2; }
  }
</style>

<script>
  const speciesSearch = document.querySelector<HTMLInputElement>("[data-species-search]");
  const searchStatus = document.querySelector<HTMLElement>("[data-search-status]");
  const speciesCards = Array.from(document.querySelectorAll<HTMLElement>("[data-species-card]"));
  const speciesSections = Array.from(document.querySelectorAll<HTMLElement>("[data-species-section]"));

  speciesSearch?.addEventListener("input", () => {
    const query = speciesSearch.value.trim().toLocaleLowerCase();
    let visibleCount = 0;

    speciesCards.forEach((card) => {
      const matches = (card.dataset.searchTerms || "").toLocaleLowerCase().includes(query);
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    });

    speciesSections.forEach((section) => {
      section.hidden = !section.querySelector("[data-species-card]:not([hidden])");
    });

    if (searchStatus) {
      searchStatus.textContent = query
        ? visibleCount === 0 ? "No species found." : `${visibleCount} species found.`
        : `${speciesCards.length} species`;
    }
  });

  document.querySelectorAll<HTMLElement>("[data-field-slideshow]").forEach((gallery) => {
    const slides = JSON.parse(gallery.dataset.slides || "[]") as { src: string; alt: string }[];
    const dates = JSON.parse(gallery.dataset.slideDates || "[]") as string[];
    const locations = JSON.parse(gallery.dataset.slideLocations || "[]") as (string | null)[];
    const image = gallery.querySelector<HTMLImageElement>("[data-slide-image]");
    const count = gallery.querySelector<HTMLElement>("[data-slide-count]");
    const date = gallery.closest<HTMLElement>(".field-note-card")?.querySelector<HTMLElement>("[data-slide-date]");
    const location = gallery.closest<HTMLElement>(".field-note-card")?.querySelector<HTMLElement>("[data-slide-location]");
    const previous = gallery.querySelector<HTMLButtonElement>("[data-slide-previous]");
    const next = gallery.querySelector<HTMLButtonElement>("[data-slide-next]");
    if (!image || slides.length < 2) return;

    let current = 0;
    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      image.src = slides[current].src;
      image.alt = slides[current].alt;
      if (count) count.textContent = `${current + 1} / ${slides.length}`;
      if (date) date.textContent = dates[current] || "Date not listed";
      if (location) location.textContent = locations[current] || "Not listed";
    };
    previous?.addEventListener("click", () => show(current - 1));
    next?.addEventListener("click", () => show(current + 1));
  });
</script>
