---
import '../styles/global.css';
import { sitePath } from '../utils/site-path.js';
const { title = 'Kyle J. Gillett', description = 'Meteorologist, researcher, software developer, and photographer.', canonical, fullTitle } = Astro.props;
// Alias pages pass `canonical` so search engines credit the page they duplicate.
const pageUrl = new URL(canonical ? sitePath(canonical) : Astro.url.pathname, Astro.site);
const cardUrl = new URL(sitePath('/og-card.jpg'), Astro.site);
const pageTitle = fullTitle ?? `${title} | Kyle J. Gillett`;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const normalizePath = (path) => sitePath(path).replace(/\/+$/, '') || '/';
const isAtOrBelow = (path) => {
  const route = normalizePath(path);
  return currentPath === route || currentPath.startsWith(`${route}/`);
};
const currentHome = currentPath === normalizePath('/');
const currentPhotography = isAtOrBelow('/photography/');
const currentWork = ['/about_and_work/', '/about/', '/work/', '/plots/'].some(isAtOrBelow);
const currentPosts = ['/posts/', '/chase-log-june-19th-2025-dickinson-north-dakota-wedge/'].some(isAtOrBelow);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kyle J. Gillett" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A broad supercell storm structure over green plains at sunset." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={sitePath('/favicon.png')} type="image/png" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header" style={`--header-map: url("${sitePath('/500_heights.gif')}")`}>
      <a class="brand" href={sitePath('/')}>Kyle J. Gillett<span>Photographer, Storm Chaser, Meteorologist, Researcher.</span></a>
      <nav aria-label="Main navigation">
        <div class="site-nav-links">
          <a href={sitePath('/')} aria-current={currentHome ? 'page' : undefined}>Home</a>
          <a href={sitePath('/photography/')} aria-current={currentPhotography ? 'page' : undefined}>Photo Gallery</a>
          <a href={sitePath('/about_and_work/')} aria-current={currentWork ? 'page' : undefined}>Research, Tools, CV, &amp; About</a>
          <a href={sitePath('/posts/')} aria-current={currentPosts ? 'page' : undefined}>Meteorological Musings</a>
        </div>
        <details class="site-nav-mobile">
          <summary>Menu</summary>
          <div class="site-nav-mobile-links">
            <a href={sitePath('/')} aria-current={currentHome ? 'page' : undefined}>Home</a>
            <a href={sitePath('/photography/')} aria-current={currentPhotography ? 'page' : undefined}>Photo Gallery</a>
            <a href={sitePath('/about_and_work/')} aria-current={currentWork ? 'page' : undefined}>Research, Tools, CV, &amp; About</a>
            <a href={sitePath('/posts/')} aria-current={currentPosts ? 'page' : undefined}>Meteorological Musings</a>
          </div>
        </details>
      </nav>
    </header>
    <main><slot /></main>
    <footer><span>© {new Date().getFullYear()} Kyle J. Gillett</span></footer>
  </body>
</html>
